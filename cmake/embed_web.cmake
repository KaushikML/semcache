# Script mode (cmake -P): writes OUT, a C++ file with every file in FILES as a byte array, plus a
# table for semcache::web::find_asset(). Invoked by a custom command so edits to web/ rebuild it.
#   cmake -DOUT=<file.cpp> "-DFILES=<a;b;...>" -P embed_web.cmake
set(arrays "")
set(table "")
set(i 0)
foreach(f IN LISTS FILES)
  get_filename_component(name "${f}" NAME)
  file(READ "${f}" hex HEX)
  string(LENGTH "${hex}" hex_len)
  math(EXPR size "${hex_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND arrays "const unsigned char kData${i}[] = {${bytes} 0x00};\n")
  string(APPEND table "    {\"${name}\", std::string_view(reinterpret_cast<const char*>(kData${i}), ${size})},\n")
  math(EXPR i "${i} + 1")
endforeach()
file(WRITE "${OUT}" "// GENERATED by cmake/embed_web.cmake from web/. Do not edit.
#include \"web/assets.hpp\"

#include <array>
#include <utility>

namespace semcache::web {
namespace {
${arrays}
const std::array<std::pair<std::string_view, std::string_view>, ${i}> kFiles = {{
${table}}};
}  // namespace

std::optional<std::string_view> embedded_file(std::string_view name) {
  for (const auto& [n, data] : kFiles) {
    if (n == name) return data;
  }
  return std::nullopt;
}

}  // namespace semcache::web
")
